    "#9b5de5", "#f15bb5", "#fee440", "#00bbf9", "#00f5d4"
]

# --- Cluster centers & labels ---
df_labels = (
    df_vis.groupby("cluster")[["UMAP 1", "UMAP 2"]]
    .mean()
    .reset_index()
)
df_labels["label"] = df_labels["cluster"].map(dicti)

# --- Base scatter plot ---
fig = px.scatter(
    df_vis,
    x="UMAP 1",
    y="UMAP 2",
