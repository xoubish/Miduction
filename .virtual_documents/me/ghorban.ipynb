# --- Moody glowing palette ---
neo_expressionist_palette = [
    "#F72585", "#7209B7", "#3A0CA3", "#4361EE", "#4CC9F0",
    "#FFB703", "#FB8500", "#E63946", "#9A031E", "#5F0F40",
